# Uncomment the next line to define a global platform for your project
platform :ios, '15.0'

ENV['SWIFT_VERSION'] = '5'

project 'CYLTabBarController-Swift.xcodeproj'

target 'CYLTabBarController-Swift' do
  # Comment the next line if you're not using Swift and don't want to use dynamic frameworks
  use_frameworks!
  
#  pod 'CYLTabBarController', '1.99.4'
#  pod 'CYLTabBarContr oller', :path => '../'
  pod 'CYLTabBarController/Lottie', :path => '../'
  # Third-party code: its warnings are not ours to fix.
  pod 'lottie-ios', :inhibit_warnings => true

  # Pods for CYLTabBarController-Swift

end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
