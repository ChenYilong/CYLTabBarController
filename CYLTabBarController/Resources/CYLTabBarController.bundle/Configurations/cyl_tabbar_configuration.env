# .env: KEY=value, "__" separates the path parts.
# .env：KEY=value，用 "__" 分隔路径。
export CYLTabBarControllerContext=CYLConfigurationDemo
CYLTabBarControllerStyleType=default
CYLTabBarControllerImageInsets="{0, 0, 0, 0}"
CYLTabBarControllerTitlePositionAdjustment="{0, -2}"
CYLTabBarControllerTabBarItemsAttributes__0__CYLTabBarItemTitle=ENV
CYLTabBarControllerTabBarItemsAttributes__0__CYLTabBarItemImage=system:house
CYLTabBarControllerTabBarItemsAttributes__0__CYLTabBarItemSelectedImage=system:house.fill
CYLTabBarControllerTabBarItemsAttributes__0__CYLTabBarItemIdentifier=home
CYLTabBarControllerTabBarItemsAttributes__1__CYLTabBarItemTitle=Message
CYLTabBarControllerTabBarItemsAttributes__1__CYLTabBarItemImage=system:message
CYLTabBarControllerTabBarItemsAttributes__1__CYLTabBarItemSelectedImage=system:message.fill
CYLTabBarControllerTabBarItemsAttributes__1__CYLTabBarItemIdentifier=message
CYLTabBarControllerTabBarItemsAttributes__1__CYLTabBarItemPlatforms="ios,android"
CYLTabBarControllerTabBarItemsAttributes__2__CYLTabBarItemTitle=Discover
CYLTabBarControllerTabBarItemsAttributes__2__CYLTabBarItemImage=system:safari
CYLTabBarControllerTabBarItemsAttributes__2__CYLTabBarItemSelectedImage=system:safari.fill
CYLTabBarControllerTabBarItemsAttributes__2__CYLTabBarItemIdentifier=discover
CYLTabBarControllerTabBarItemsAttributes__2__CYLTabBarItemPageIdentifier=web
CYLTabBarControllerTabBarItemsAttributes__2__CYLTabBarItemPageParameters__url=https://github.com/ChenYilong/CYLTabBarController
CYLTabBarControllerTabBarItemsAttributes__2__CYLTabBarItemImageInsets="{1, 0, -1, 0}"
CYLTabBarControllerTabBarItemsAttributes__3__CYLTabBarItemTitle=Me
CYLTabBarControllerTabBarItemsAttributes__3__CYLTabBarItemImage=system:person
CYLTabBarControllerTabBarItemsAttributes__3__CYLTabBarItemSelectedImage=system:person.fill
CYLTabBarControllerTabBarItemsAttributes__3__CYLTabBarItemIdentifier=me
CYLTabBarControllerTabBarItemsAttributes__3__CYLTabBarItemMinimumAppVersion=1.0.0
CYLTabBarControllerTabBarItemsAttributes__3__CYLTabBarItemTitlePositionAdjustment="{0, -1}"
