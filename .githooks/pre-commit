#!/bin/sh
# [EN] Blocks a commit that adds or changes a screenshot in docs/assets without the header, captions and footer of
#      docs/Screenshot-Guidelines.md (built by scripts/stitch-screenshots.py). Installed by scripts/install-git-hooks.sh.
# [CN] 阻止提交没有页眉、说明与页脚（由 scripts/stitch-screenshots.py 生成）的 docs/assets 截图。
root=$(git rev-parse --show-toplevel) || exit 0
command -v python3 >/dev/null 2>&1 || { echo "pre-commit: python3 not found, screenshot labels not checked" >&2; exit 0; }
python3 "$root/scripts/check-screenshot-labels.py" --staged || {
    echo "pre-commit: screenshot without labels. Rebuild it with python3 scripts/stitch-screenshots.py (docs/Screenshot-Guidelines.md)." >&2
    exit 1
}
if [ -x "$root/.git/hooks/pre-commit.chained" ]; then
    exec "$root/.git/hooks/pre-commit.chained" "$@"
fi
exit 0
