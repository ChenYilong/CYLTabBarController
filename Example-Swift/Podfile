# Uncomment the next line to define a global platform for your project
# source 'git@github.com:CocoaPods/Specs.git'

platform :ios, '15.0'

ENV['SWIFT_VERSION'] = '5'

project 'CYLTabBarController-Swift.xcodeproj'
inhibit_all_warnings!

target 'CYLTabBarController-Swift' do
  use_frameworks!
  
  
  #pod 'CYLTabBarController', '~> 1.99.18'        # 默认不依赖Lottie
  #pod 'CYLTabBarController/Lottie', '~> 1.99.18'  # 依赖Lottie Objective-C库
  #pod 'CYLTabBarController/LottieSwift', '~> 1.99.18'  # 依赖Lottie Swift库
  
# pod 'CYLTabBarController', :path => '../'
# pod 'CYLTabBarController/Lottie', :path => '../'
 pod 'CYLTabBarController/LottieSwift', :path => '../'
 pod 'CYLDeallocBlockExecutor', :git => 'https://github.com/ChenYilong/CYLDeallocBlockExecutor.git', :commit => '38d67f5a714c1f1407aee14e12e974af66bd2787' # TODO: remove after CYLDeallocBlockExecutor 1.4.0 is published (docs/Lifecycle-Library.md)
 # [EN] The animated item component's own pod (CYLAnimatedItem.podspec), by the same path until it is on the trunk.
 # [CN] 动效组件独立的 pod（CYLAnimatedItem.podspec），发布到 trunk 之前按相同路径引入。
 pod 'CYLAnimatedItem', :path => '../'

end
 
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
