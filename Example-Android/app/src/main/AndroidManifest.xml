<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.CYLTabBarPages">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TwoTabBarsActivity"
            android:exported="false"
            android:label="@string/two_tab_bars" />
        <activity
            android:name=".DemoHostActivity"
            android:exported="false" />
        <activity
            android:name=".DemoGalleryActivity"
            android:exported="false" />
        <!-- [EN] Keeps the language chosen in the demo (AppCompatDelegate.setApplicationLocales) before Android 13. [CN] 在 Android 13 之前保存演示中选择的语言。 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
