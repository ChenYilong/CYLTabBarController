<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- [EN] SVGAPlayer-Android sets allowBackup="true" in its manifest; this app keeps false. [CN] SVGAPlayer-Android 的 manifest 设置了 allowBackup="true"；本 App 保持 false。 -->
    <application
        tools:replace="android:allowBackup"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.CYLTabBarExample">
        <!-- configChanges uiMode: the course forces night (localNightMode = MODE_NIGHT_YES), so a system light / dark switch
             needs no new activity; recreating it crashed in ART's JIT thread on the Android 17 x86_64 emulator (SIGSEGV in
             JitCompileTask::Finalize, 2026-11-18/19; 6 live switches without a crash after this). Example-only: the library
             cannot change how an app's activity is recreated; its views still follow the mode in onConfigurationChanged. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
