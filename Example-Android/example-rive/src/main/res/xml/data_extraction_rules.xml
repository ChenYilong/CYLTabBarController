<?xml version="1.0" encoding="utf-8"?>
<!-- [EN] The demo keeps nothing in backups or device transfers. [CN] 演示 App 不在备份或设备迁移中保留任何数据。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
