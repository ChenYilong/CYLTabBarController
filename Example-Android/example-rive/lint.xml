<?xml version="1.0" encoding="UTF-8"?>
<!--
  [EN] Lint settings of the demo app.
       - SetTextI18n: the demo rows show API and event names (e.g. "cyl_pushViewController, then pop"), the same in every
         language, as the iOS demo marks them untranslated (CYLScrollHideSimulationUntranslatedText). User-facing app
         strings stay in res/values and res/values-zh-rCN.
       - GradleDependency / AndroidGradlePluginVersion: the versions are pinned in gradle/libs.versions.toml and in the
         lock files, so CI builds the same thing; they are raised on purpose, not by lint.
  [CN] 演示 App 的 lint 设置。
       - SetTextI18n：演示行显示 API 与事件名称（如 "cyl_pushViewController, then pop"），各语言相同，与 iOS 演示将其标记为无需翻译一致
         （CYLScrollHideSimulationUntranslatedText）。面向用户的 App 文字仍放在 res/values 与 res/values-zh-rCN 中。
       - GradleDependency / AndroidGradlePluginVersion：版本固定在 gradle/libs.versions.toml 与锁文件中，CI 构建结果一致；版本是有意升级的，
         不由 lint 决定。
-->
<lint>
    <issue id="SetTextI18n">
        <ignore path="src/main/kotlin/com/cyl/tabbar/demo/**" />
        <!-- [EN] The course's copy is English only, as in the iOS example (Example-SwiftUI-Rive). [CN] 课程文字只有英文，与 iOS 示例（Example-SwiftUI-Rive）相同。 -->
        <ignore path="src/main/kotlin/com/cyl/tabbar/example/rive/**" />
    </issue>
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- [EN] The lint check of lifecycle 2.9 (from rive-android) crashes lint 8.7 (NonNullableMutableLiveDataDetector); this app has no LiveData. [CN] lifecycle 2.9（来自 rive-android）的 lint 检查会让 lint 8.7 崩溃（NonNullableMutableLiveDataDetector）；本 App 不使用 LiveData。 -->
    <issue id="NullSafeMutableLiveData" severity="ignore" />
</lint>
