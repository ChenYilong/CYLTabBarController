platform :ios, '15.0'

ENV['SWIFT_VERSION'] = '5'

project 'RiveApp.xcodeproj'

target 'RiveApp' do
  use_frameworks!

  # CYLTabBarController with Rive tab icons; it also brings the RiveRuntime pod.
  # CYLTabBarController 与 Rive Tab 图标；同时引入 RiveRuntime pod。
  pod 'CYLTabBarController/Rive', :path => '../'
  # The FlatDesign style, chosen with the navigation bar button of the settings list. It also brings Lottie.
  # 扁平样式，通过设置列表的导航栏按钮选择。它同时会引入 Lottie。
  pod 'CYLTabBarController/CYLFlatDesignTabBar', :path => '../'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
