// JSON5: comments, unquoted keys, single quotes and trailing commas.
// JSON5：注释、不加引号的键、单引号与尾逗号。
{
  CYLTabBarControllerContext: 'CYLConfigurationDemo',
  CYLTabBarControllerLocalization: { CYLTabBarLocalizationTableName: 'ConfigurationDemo', CYLTabBarLocalizationPath: 'Localization' },
  CYLTabBarControllerThemeManagerName: 'CYLConfigurationDemo',
  CYLTabBarControllerThemeIdentifier: 'light',
  CYLTabBarControllerDarkThemeIdentifier: 'dark',
  CYLTabBarControllerThemes: {
    light: { CYLTabBarItemSelectedTitleColor: '#007AFF', CYLTabBarItemSelectedIconColor: '#007AFF' },
    dark: { CYLTabBarItemSelectedTitleColor: '#0A84FF', CYLTabBarItemSelectedIconColor: '#0A84FF', CYLTabBarBackgroundColor: '#1C1C1E' },
  },
  CYLTabBarControllerStyleType: 'default',
  CYLTabBarControllerImageInsets: '{0, 0, 0, 0}',
  CYLTabBarControllerTitlePositionAdjustment: '{0, -2}',
  /* One dictionary per tab. 每个 Tab 一个字典。 */
  CYLTabBarControllerTabBarItemsAttributes: [
    {
      CYLTabBarItemTitle: 'JSON5',
      CYLTabBarItemImage: 'system:house',
      CYLTabBarItemSelectedImage: 'system:house.fill',
      CYLTabBarItemIdentifier: 'home',
    },
    {
      CYLTabBarItemTitle: 'Message',
      CYLTabBarItemImage: 'system:message',
      CYLTabBarItemSelectedImage: 'system:message.fill',
      CYLTabBarItemIdentifier: 'message',
      CYLTabBarItemPlatforms: 'ios,android',
    },
    {
      CYLTabBarItemTitle: 'Discover',
      CYLTabBarItemImage: 'system:safari',
      CYLTabBarItemSelectedImage: 'system:safari.fill',
      CYLTabBarItemIdentifier: 'discover',
      CYLTabBarItemPageIdentifier: 'web',
      CYLTabBarItemPageParameters: { url: 'https://github.com/ChenYilong/CYLTabBarController' },
      CYLTabBarItemImageInsets: '{1, 0, -1, 0}',
    },
    {
      CYLTabBarItemTitle: 'Me',
      CYLTabBarItemImage: 'system:person',
      CYLTabBarItemSelectedImage: 'system:person.fill',
      CYLTabBarItemIdentifier: 'me',
      CYLTabBarItemMinimumAppVersion: '1.0.0',
      CYLTabBarItemTitlePositionAdjustment: '{0, -1}',
    },
  ],
}
