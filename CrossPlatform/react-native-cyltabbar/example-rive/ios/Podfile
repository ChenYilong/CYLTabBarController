# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

ENV['SWIFT_VERSION'] = '5'

project 'CyltabbarExample.xcodeproj'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'CyltabbarExample' do
  config = use_native_modules!

  # CYLTabBarController from this repository with its Rive subspec (RiveRuntime), as Example-Rive.
  pod 'CYLTabBarController/Rive', :path => '../../../..'
  pod 'CYLDeallocBlockExecutor', :git => 'https://github.com/ChenYilong/CYLDeallocBlockExecutor.git', :commit => '6aef46d97fb79a4530931d84a17e828c67f35444' # TODO: remove after CYLDeallocBlockExecutor 1.4.0 is published (docs/Lifecycle-Library.md)
  # [EN] The animated item component's own pod (CYLAnimatedItem.podspec), by the same path until it is on the trunk.
  # [CN] 动效组件独立的 pod（CYLAnimatedItem.podspec），发布到 trunk 之前按相同路径引入。
  pod 'CYLAnimatedItem', :path => '../../../..'
  # FIX: issue #415 — SVGA tab icons (SVGAPlayer), one for one with the Rive ones, as Example-Rive.
  # SVGA Tab 图标（SVGAPlayer），与 Rive 图标一一对应，与 Example-Rive 相同。
  pod 'CYLTabBarController/SVGA', :path => '../../../..'
  # [EN] Static linking: the Swift library imports these Objective-C pods, so they need module maps.
  # [CN] 静态链接：Swift 库导入这两个 Objective-C pod，因此它们需要 module map。
  pod 'SVGAPlayerLite', :modular_headers => true
  pod 'Protobuf', :modular_headers => true

  # [EN] The unit tests of the bridge view (CyltabbarExampleTests) only need the headers; the host app links the code.
  # [CN] 桥接视图的单元测试（CyltabbarExampleTests）只需要头文件，代码由宿主 App 链接。
  target 'CyltabbarExampleTests' do
    inherit! :search_paths
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # [EN] Every pod at React Native's minimum deployment target (15.1, `min_ios_version_supported`): the 15.0 of
    #      AGENTS.md ("Xcode projects") is below what React Native supports. Some pods declare less (lottie-ios iOS 13,
    #      RiveRuntime's resource bundle iOS 14.0), which Xcode 26 no longer builds.
    # [CN] 所有 pod 使用 React Native 的最低部署版本（15.1，`min_ios_version_supported`）：AGENTS.md（Xcode projects）中的 15.0
    #      低于 React Native 的支持版本。部分 pod 声明的版本更低（lottie-ios iOS 13、RiveRuntime 资源包 iOS 14.0），Xcode 26 已不再支持。
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = min_ios_version_supported
      end
    end
  end
end
