platform :ios, '15.0'

ENV['SWIFT_VERSION'] = '5'

project 'Runner.xcodeproj', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # [EN] Static: CYLTabBarController is a static framework. [CN] 静态链接：CYLTabBarController 是静态 framework。
  use_frameworks! :linkage => :static

  # [EN] This repository's CYLTabBarController with its Rive subspec (RiveRuntime), as Example-Rive.
  # [CN] 本仓库的 CYLTabBarController 及其 Rive 子库（RiveRuntime），与 Example-Rive 相同。
  pod 'CYLTabBarController/Rive', :path => '../../../..'
  pod 'CYLDeallocBlockExecutor', :git => 'https://github.com/ChenYilong/CYLDeallocBlockExecutor.git', :commit => '6aef46d97fb79a4530931d84a17e828c67f35444' # TODO: remove after CYLDeallocBlockExecutor 1.4.0 is published (docs/Lifecycle-Library.md)
  # [EN] The animated item component's own pod (CYLAnimatedItem.podspec), by the same path until it is on the trunk.
  # [CN] 动效组件独立的 pod（CYLAnimatedItem.podspec），发布到 trunk 之前按相同路径引入。
  pod 'CYLAnimatedItem', :path => '../../../..'
  # FIX: issue #415 — SVGA tab icons (SVGAPlayer), one for one with the Rive ones, as Example-Rive. Static linking: the
  # Swift library imports these Objective-C pods, so they need module maps.
  # SVGA Tab 图标（SVGAPlayer），与 Rive 图标一一对应，与 Example-Rive 相同。静态链接：Swift 库导入这两个 Objective-C pod，因此需要 module map。
  pod 'CYLTabBarController/SVGA', :path => '../../../..'
  pod 'SVGAPlayerLite', :modular_headers => true
  pod 'Protobuf', :modular_headers => true
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
  # [EN] AGENTS.md ("Xcode projects"): every pod at iOS 15.0. [CN] AGENTS.md（Xcode projects）：所有 pod 使用 iOS 15.0。
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
