<!-- [EN] One 2D canvas per Rive animation. In WeChat DevTools a still image of the frame covers it while the page scrolls (CYL_USES_SNAPSHOTS in index.js). [CN] 每个 Rive 动画一个 2D 画布。在微信开发者工具中，页面滚动时由当前帧的静态图片覆盖（见 index.js 中的 CYL_USES_SNAPSHOTS）。 -->
<view class="cyl-rive-box">
  <canvas type="2d" id="{{cylCanvasId}}" class="cyl-rive-canvas {{cylSnapshotShown ? 'cyl-rive-canvas-covered' : ''}}" aria-role="img" aria-label="{{label}}" aria-hidden="{{!label}}"></canvas>
  <image wx:if="{{cylSnapshotShown}}" class="cyl-rive-snapshot" src="{{cylSnapshot}}" mode="scaleToFill" aria-hidden="true" />
</view>
