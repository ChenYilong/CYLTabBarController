:host {
  display: inline-block;
  width: 100px;
  height: 100px;
}

.cyl-rive-box {
  position: relative;
  width: 100%;
  height: 100%;
}

.cyl-rive-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* [EN] WeChat DevTools: off screen while the still image shows, still drawn (see cyl-lottie). [CN] 微信开发者工具：显示静态图片时移出屏幕，仍会绘制（见 cyl-lottie）。 */
.cyl-rive-canvas-covered {
  position: absolute;
  left: -10000px;
  top: 0;
  visibility: hidden;
}

.cyl-rive-snapshot {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
