.weui-navigation-bar {
  --height: 44px;
  --left: 16px;
}
.weui-navigation-bar .android {
  --height: 48px;
}

.weui-navigation-bar {
  overflow: hidden;
  color: var(--weui-FG-0);
  flex: none;
  width: 100%;
}

.weui-navigation-bar__inner {
  position: relative;
  top: 0;
  left: 0;
  height: calc(var(--height) + env(safe-area-inset-top));
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding-top: env(safe-area-inset-top);
  width: 100%;
  box-sizing: border-box;
}

.weui-navigation-bar__left {
  position: relative;
  padding-left: var(--left);
  display: flex;
  flex-direction: row;
  align-items: center;
  height: var(--height);
  box-sizing: border-box;
  z-index: 2;
}

.weui-navigation-bar__buttons {
  height: var(--height);
  display: flex;
  align-items: center;
}

.weui-navigation-bar__btn_goback_wrapper {
  width: 44px;
  height: 44px;
  margin-left: calc(0px - var(--left));
  padding-left: var(--left);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.weui-navigation-bar__btn_goback_wrapper.weui-active {
  opacity: 0.5;
}

.weui-navigation-bar__btn_goback {
  width: 20px;
  height: 20px;
}

.weui-navigation-bar__btn_home {
  width: 20px;
  height: 20px;
}

.weui-navigation-bar__center {
  font-size: 19px;
  text-align: center;
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  flex: 1;
  height: var(--height);
  white-space: nowrap;
}

.weui-navigation-bar__loading {
  margin-right: 4px;
  align-items: center;
}

.weui-loading {
  width: 16px;
  height: 16px;
  display: block;
  margin-left: 0;
  animation: loading linear infinite 1s;
}

@keyframes loading {
  from {
    transform: rotate(0);
  }
  to {
    transform: rotate(360deg);
  }
}
