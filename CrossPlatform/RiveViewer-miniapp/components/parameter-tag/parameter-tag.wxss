.parameter-tag {
  width: auto;
  min-width: 0;
  max-width: 100%;
  min-height: 48rpx;
  margin: 0;
  padding: 0 calc(15rpx + 8px);
  flex: none;
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  gap: 9rpx;
  color: #aeb7c3;
  font-size: 22rpx;
  font-weight: 640;
  white-space: nowrap;
  background: #1a2330;
  border: 1rpx solid rgba(216, 221, 229, .14);
  border-radius: 9rpx;
  transform-origin: center;
  transition:
    transform 280ms cubic-bezier(.34, 1.56, .64, 1),
    color 120ms ease,
    background-color 120ms ease;
}

.parameter-tag.is-selected,
.parameter-tag.is-active {
  color: #f2f0e8;
  background: #2d2d20;
  border-color: rgba(242, 201, 76, .38);
}

.parameter-tag__label,
.parameter-tag__detail {
  position: relative;
  z-index: 2;
}

.parameter-tag__detail {
  color: #f2c94c;
  font-size: 20rpx;
  font-weight: 600;
}

.parameter-tag.is-compact {
  min-height: 24rpx;
  padding: 0 calc(7.5rpx + 8px);
  gap: 4.5rpx;
  font-size: 11rpx;
  border-width: .5rpx;
  border-radius: 4.5rpx;
}

.parameter-tag.is-compact .parameter-tag__detail {
  font-size: 10rpx;
}

.parameter-tag__progress {
  height: 100%;
  position: absolute;
  inset: 0 auto 0 0;
  z-index: 1;
  background: rgba(242, 201, 76, .3);
  transition: width 90ms linear;
}

.parameter-tag.is-pressed {
  color: #f2f0e8;
  background: #263140;
  border-color: rgba(242, 201, 76, .72);
  box-shadow: inset 0 0 0 1rpx rgba(242, 201, 76, .16);
  position: relative;
  z-index: 20;
  transform: scale(1.25);
  transition-duration: 70ms, 120ms, 120ms;
  transition-timing-function: cubic-bezier(.2, .9, .3, 1), ease, ease;
}

.parameter-tag.is-feedback {
  animation: parameter-tag-feedback 180ms cubic-bezier(.22, 1, .36, 1);
}

@keyframes parameter-tag-feedback {
  0% {
    background: #263140;
    border-color: rgba(242, 201, 76, .76);
    box-shadow: inset 0 0 0 1rpx rgba(242, 201, 76, .2);
    transform: scale(1.25);
  }
  100% {
    transform: scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .parameter-tag {
    transition: none;
  }

  .parameter-tag.is-feedback {
    animation-duration: .01ms;
  }
}
