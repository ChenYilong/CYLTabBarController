<view
  class="parameter-tag {{compact ? 'is-compact' : ''}} {{selected ? 'is-selected' : ''}} {{active ? 'is-active' : ''}} {{feedback ? 'is-feedback' : ''}}"
  bindtap="select"
  hover-class="is-pressed"
  hover-start-time="0"
  hover-stay-time="70"
  role="button"
  aria-label="{{arialabel || label}}"
>
  <view
    wx:if="{{progressvisible}}"
    class="parameter-tag__progress"
    style="width: {{progress}}%;"
  ></view>
  <text class="parameter-tag__label">{{label}}</text>
  <text wx:if="{{detail}}" class="parameter-tag__detail">{{detail}}</text>
</view>
