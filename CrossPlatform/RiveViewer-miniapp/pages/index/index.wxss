page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.desktop-workspace {
  min-width: 0;
  min-height: 0;
  display: flex;
  flex: 1;
  overflow: hidden;
  background: #0b0f14;
}

.desktop-home-pane {
  min-width: 0;
  min-height: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  overflow: hidden;
}

.desktop-home-content {
  min-width: 0;
  min-height: 0;
  display: flex;
  flex: 1;
  transform-origin: left top;
}

.desktop-preview-pane {
  width: 50%;
  min-width: 0;
  height: 100%;
  flex: none;
  overflow: hidden;
  background: #0b0f14;
}

.desktop-workspace.is-split.has-preview .desktop-home-pane {
  width: 50%;
  flex: none;
}

.desktop-workspace.is-split.has-preview .desktop-home-content {
  width: 200%;
  height: 200%;
  flex: none;
  transform: scale(.5);
}

.desktop-workspace.is-split.has-preview .page-scroll {
  width: 100%;
  height: 100%;
  flex: none;
}

.page-scroll {
  min-height: 0;
  flex: 1;
}

.page-shell {
  padding: 34rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
}

.import-dropzone {
  width: 100%;
  min-height: 260rpx;
  padding: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #f2f0e8;
  text-align: center;
  background: #0f151e;
  border: 2rpx dashed #354355;
  border-radius: 24rpx;
  transform-origin: center;
  transition:
    transform 280ms cubic-bezier(.34, 1.56, .64, 1),
    border-color 120ms ease,
    background-color 120ms ease;
}

.import-dropzone.is-pressed {
  position: relative;
  z-index: 5;
  background: #151e29;
  border-color: #f2c94c;
  transform: scale(1.025);
  transition-duration: 70ms, 120ms, 120ms;
  transition-timing-function: cubic-bezier(.2, .9, .3, 1), ease, ease;
}

.import-dropzone__mark {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2c94c;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(242, 201, 76, 0.16);
}

.import-dropzone__plus {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.import-dropzone__title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.library-section {
  margin-top: 38rpx;
}

.web-link-footer {
  min-width: 0;
  margin: 38rpx 4rpx 0;
  padding: 28rpx 20px 0;
  display: flex;
  align-items: center;
}

.web-link-footer__label {
  flex: none;
  color: #8c98a8;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
  margin-right: 10rpx;
}

.web-link-footer__url-wrap {
  min-width: 0;
  flex: 1;
  position: relative;
  overflow: hidden;
}

.web-link-footer__url {
  display: block;
  color: #f2c94c;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.web-link-footer__url-fade {
  width: 42rpx;
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(11, 15, 20, 0), #0b0f14 82%);
}

.web-link-footer__copy {
  width: 60rpx;
  height: 60rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a2330;
  border: 1rpx solid #2c3949;
  border-radius: 12rpx;
  transform-origin: center;
  transition:
    transform 280ms cubic-bezier(.34, 1.56, .64, 1),
    background-color 120ms ease,
    border-color 120ms ease;
}

.web-link-footer__copy-icon {
  width: 28rpx;
  height: 28rpx;
}

.author-contact {
  margin: 34rpx auto 0;
  padding: 14rpx 20rpx;
  color: #687588;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
  transform-origin: center;
  transition:
    transform 280ms cubic-bezier(.34, 1.56, .64, 1),
    color 120ms ease,
    background-color 120ms ease;
  border-radius: 12rpx;
}

.section-heading {
  margin: 0 4rpx 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.section-title {
  color: #f2f0e8;
  font-size: 34rpx;
  font-weight: 720;
}

.section-note {
  color: #8c98a8;
  font-size: 24rpx;
}

.file-list {
  background: #121923;
  border: 1rpx solid #253142;
  border-radius: 24rpx;
}

.file-row {
  min-height: 174rpx;
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 92rpx;
  align-items: stretch;
  background: #121923;
  transition: background-color 160ms ease, transform 160ms ease;
}

.file-row:first-child {
  border-radius: 24rpx 24rpx 0 0;
}

.file-row:last-child {
  border-radius: 0 0 24rpx 24rpx;
}

.file-row:only-child {
  border-radius: 24rpx;
}

.file-row + .file-row {
  border-top: 1rpx solid #202a37;
}

.file-row--pressed {
  position: relative;
  z-index: 5;
  background: #18212d;
  transform: scale(1.025);
  transition-duration: 70ms, 120ms;
  transition-timing-function: cubic-bezier(.2, .9, .3, 1), ease;
}

.file-open {
  width: 100%;
  min-width: 0;
  padding: 16rpx 8rpx 16rpx 14rpx;
  display: grid;
  grid-template-columns: 184rpx minmax(0, 1fr);
  align-items: center;
  justify-content: stretch;
  column-gap: 18rpx;
  color: inherit;
  text-align: left;
  background: transparent;
  transform-origin: center;
  transition:
    transform 280ms cubic-bezier(.34, 1.56, .64, 1),
    background-color 120ms ease;
}

.file-row--menu-open {
  z-index: 6;
  background: #151e29;
}

.file-cover {
  width: 184rpx;
  height: 138rpx;
  flex: none;
  overflow: hidden;
  background: #1b2632;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 13rpx;
  box-shadow: 0 9rpx 18rpx rgba(0, 4, 10, 0.26);
}

.file-cover__image {
  width: 100%;
  height: 100%;
}

.file-cover__fallback {
  width: 100%;
  height: 100%;
  padding: 14rpx;
  display: flex;
  align-items: flex-end;
  color: #17130a;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.15), transparent 52%),
    #d9aa24;
}

.file-main {
  min-width: 0;
  flex: 1;
  text-align: left;
}

.file-title-line {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
}

.file-name {
  min-width: 0;
  overflow: hidden;
  color: #f2f0e8;
  font-size: 28rpx;
  font-weight: 680;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-badge {
  flex: none;
  padding: 4rpx 9rpx;
  color: #f2c94c;
  font-size: 21rpx;
  font-weight: 650;
  background: #252719;
  border-radius: 7rpx;
}

.file-summary,
.file-meta {
  display: block;
  overflow: hidden;
  color: #8c98a8;
  font-size: 24rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-summary {
  margin-top: 8rpx;
}

.file-meta {
  margin-top: 4rpx;
  color: #687588;
}

.file-action {
  width: 92rpx;
  padding-right: 14px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.file-menu-toggle {
  width: 62rpx;
  min-width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a2330;
  border: 1rpx solid #2c3949;
  border-radius: 12rpx;
  transform-origin: center;
  transition:
    transform 280ms cubic-bezier(.34, 1.56, .64, 1),
    background-color 120ms ease,
    border-color 120ms ease;
}

.file-menu-toggle.is-open {
  background: #f2c94c;
  border-color: #f2c94c;
}

.file-menu-chevron {
  width: 28rpx;
  height: 28rpx;
  transition: transform 160ms ease, filter 160ms ease;
}

.file-menu-toggle.is-open .file-menu-chevron {
  filter: brightness(0.18);
  transform: rotate(180deg);
}

.file-menu {
  width: 210rpx;
  position: absolute;
  top: 124rpx;
  right: 15rpx;
  z-index: 9;
  overflow: hidden;
  background: #1b2531;
  border: 1rpx solid #344153;
  border-radius: 14rpx;
  box-shadow: 0 18rpx 38rpx rgba(0, 4, 10, 0.5);
}

.file-menu button {
  width: 100%;
  height: 72rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e5e8ed;
  font-size: 25rpx;
  font-weight: 610;
  text-align: center;
  background: #1b2531;
  transform-origin: center;
  transition:
    transform 280ms cubic-bezier(.34, 1.56, .64, 1),
    background-color 120ms ease,
    color 120ms ease;
}

.file-menu button + button {
  border-top: 1rpx solid #2a3543;
}

.file-menu .file-menu__danger {
  color: #e28585;
}

.file-menu-toggle.is-pressed,
.file-menu button.is-pressed,
.web-link-footer__copy.is-pressed,
.author-contact.is-pressed {
  position: relative;
  z-index: 20;
  transform: scale(1.25);
  transition-duration: 70ms, 120ms, 120ms;
  transition-timing-function: cubic-bezier(.2, .9, .3, 1), ease, ease;
}

.file-menu-toggle.is-pressed,
.web-link-footer__copy.is-pressed {
  background: #252719;
  border-color: #f2c94c;
}

.file-menu button.is-pressed {
  background: #253142;
}

.author-contact.is-pressed {
  color: #96a2b2;
  background: #121923;
}

@media (prefers-reduced-motion: reduce) {
  .import-dropzone,
  .file-open,
  .file-row,
  .file-menu-toggle,
  .file-menu button,
  .web-link-footer__copy,
  .author-contact {
    transition: none;
  }
}
