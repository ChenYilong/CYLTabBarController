<view class="desktop-workspace {{desktopSplitEnabled ? 'is-split' : ''}} {{desktopPreviewFileId ? 'has-preview' : ''}}">
  <view class="desktop-home-pane">
    <navigation-bar title="Rive 预览台" back="{{false}}" color="#f2f0e8" background="#0b0f14"></navigation-bar>
    <view class="desktop-home-content">

      <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="page-shell">
    <view
      class="import-dropzone"
      bindtap="showImportMenu"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="70"
      role="button"
      aria-label="导入 Rive 文件"
    >
      <view class="import-dropzone__mark">
        <image class="import-dropzone__plus" src="/assets/icons/plus.svg"></image>
      </view>
      <text class="import-dropzone__title">导入 Rive 文件</text>
    </view>

    <view class="library-section">
      <view class="section-heading">
        <text class="section-title">最近文件</text>
        <text class="section-note">{{files.length}} 个</text>
      </view>

      <view class="file-list">
        <view
          class="file-row {{expandedFileId === item.id ? 'file-row--menu-open' : ''}}"
          wx:for="{{files}}"
          wx:key="id"
        >
          <view
            class="file-open"
            data-id="{{item.id}}"
            data-index="{{index}}"
            catchtap="openFile"
            hover-class="file-row--pressed"
            hover-start-time="0"
            hover-stay-time="70"
            role="button"
            aria-label="预览 {{item.name}}"
          >
            <view class="file-cover">
              <image
                wx:if="{{item.cover}}"
                class="file-cover__image"
                src="{{item.cover}}"
                mode="aspectFill"
              ></image>
              <view wx:else class="file-cover__fallback">
                <text>RIV</text>
              </view>
            </view>
            <view class="file-main">
              <view class="file-title-line">
                <text class="file-name">{{item.name}}</text>
                <text wx:if="{{item.builtin}}" class="file-badge">示例</text>
              </view>
              <text class="file-summary">{{item.summary}}</text>
              <text class="file-meta">{{item.displaySize}} / {{item.displayDate}}</text>
            </view>
          </view>
          <view class="file-action">
            <view
              class="file-menu-toggle {{expandedFileId === item.id ? 'is-open' : ''}}"
              data-id="{{item.id}}"
              catchtap="toggleFileMenu"
              hover-class="is-pressed"
              hover-start-time="0"
              hover-stay-time="70"
              role="button"
              aria-label="文件操作"
            >
              <image class="file-menu-chevron" src="/assets/icons/chevron-down.svg"></image>
            </view>
          </view>
          <view
            wx:if="{{expandedFileId === item.id}}"
            class="file-menu"
            catchtap="toggleFileMenu"
          >
            <button data-id="{{item.id}}" catchtap="shareFile" hover-class="is-pressed" hover-start-time="0" hover-stay-time="70">发送文件</button>
            <button
              class="file-menu__danger"
              data-id="{{item.id}}"
              catchtap="deleteFile"
              hover-class="is-pressed"
              hover-start-time="0"
              hover-stay-time="70"
            >删除文件</button>
          </view>
        </view>
      </view>
    </view>

    <view class="web-link-footer">
      <text class="web-link-footer__label">复杂文件用网页版更流畅：</text>
      <view class="web-link-footer__url-wrap">
        <text class="web-link-footer__url" user-select="true">mikeywa.site/rive-viewer/</text>
        <view class="web-link-footer__url-fade" aria-hidden="true"></view>
      </view>
      <view
        class="web-link-footer__copy"
        bindtap="copyWebViewerUrl"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="70"
        role="button"
        aria-label="复制网页版预览地址"
      >
        <image class="web-link-footer__copy-icon" src="/assets/icons/copy-simple.svg"></image>
      </view>
    </view>

    <view
      class="author-contact"
      bindtap="showAuthorWechat"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="70"
      role="button"
      aria-label="联系作者反馈意见，查看作者微信号"
    >联系作者反馈意见</view>
  </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{desktopSplitEnabled && desktopPreviewFileId}}" class="desktop-preview-pane">
    <preview-panel
      file-id="{{desktopPreviewFileId}}"
      bindclose="closeDesktopPreview"
      bindselectfile="selectDesktopPreviewFile"
    ></preview-panel>
  </view>
</view>
