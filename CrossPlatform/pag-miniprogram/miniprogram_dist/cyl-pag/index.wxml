<!-- [EN] One WebGL canvas per PAG animation. In WeChat DevTools the canvas only draws, off screen, and one image of it shows the animation (CYL_USES_SNAPSHOTS in index.js). [CN] 每个 PAG 动画一个 WebGL 画布。在微信开发者工具中，画布只在屏幕外绘制，由其一张图片显示动画（见 index.js 中的 CYL_USES_SNAPSHOTS）。 -->
<view class="cyl-pag-box">
  <canvas type="webgl" id="{{cylCanvasId}}" class="cyl-pag-canvas {{cylCovered ? 'cyl-pag-canvas-covered' : ''}}" aria-role="img" aria-label="{{label}}" aria-hidden="{{!label}}"></canvas>
  <image wx:if="{{cylCovered && cylSnapshot}}" class="cyl-pag-snapshot" src="{{cylSnapshot}}" mode="scaleToFill" aria-hidden="true" />
</view>
