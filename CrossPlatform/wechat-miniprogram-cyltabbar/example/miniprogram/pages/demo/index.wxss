/* [EN] A transformed frame holds the fixed cyl-tab-bar inside the page. [CN] 带 transform 的框把 fixed 定位的 cyl-tab-bar 留在页面内。 */
.cyl-demo-frame { position: relative; transform: translateZ(0); height: 110px; margin: 12px 16px; border-radius: 12px; overflow: hidden; background: var(--cyl-background, #f2f2f7); }
.cyl-demo-scale { position: absolute; left: 0; right: 0; bottom: 0; height: 50px; transform-origin: bottom; }
.cyl-demo-code { font-family: Menlo, monospace; font-size: 12px; word-break: break-all; }
.cyl-demo-items { display: flex; flex-direction: row; height: 64px; }
.cyl-demo-item { flex: 1; position: relative; }
.cyl-demo-slides { overflow: hidden; height: 120px; }
.cyl-demo-slide-track { display: flex; height: 100%; transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1); }
.cyl-demo-slide { flex: 0 0 100%; display: flex; align-items: center; justify-content: center; font-size: 22px; }
.cyl-demo-spacer { height: 2000px; }
