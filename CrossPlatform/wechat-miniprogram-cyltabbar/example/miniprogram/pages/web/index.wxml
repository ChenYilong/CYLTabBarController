<!-- [EN] Arabic: the page right to left. [CN] 阿拉伯语：页面从右到左。 -->
<page-meta page-style="{{cylRTL ? 'direction: rtl;' : ''}}"></page-meta>
<import src="/templates/cyl_feed.wxml" />
<!-- [EN] A replaced tab's plain page (Home row "Replace neighboring tabs", issue #481). [CN] 被替换 Tab 的空白页面（issue #481）。 -->
<view wx:if="{{replaced}}" id="cyl-replaced-page" class="cyl-replaced-page" style="background-color: {{replaced.color}};" aria-label="{{replaced.title}}"></view>
<view wx:if="{{!cylUnloaded}}" class="cyl-page" bindtouchstart="cyl_onSwipeStart" bindtouchend="cyl_onSwipeEnd">
  <view class="cyl-header">
    <text class="cyl-header-title" aria-role="heading">{{texts['Discover']}}</text>
  </view>
  <text class="cyl-section-title" aria-role="heading">{{texts['Page parameters']}}</text>
  <view class="cyl-section">
    <view class="cyl-row cyl-row-action" bindtap="cyl_copyValue" data-value="web" aria-role="button" aria-label="{{texts['Page identifier']}}, web">
      <text aria-hidden="true">{{texts['Page identifier']}}</text>
      <text class="cyl-row-value" aria-hidden="true">web</text>
    </view>
    <view class="cyl-row cyl-row-action" bindtap="cyl_copyValue" data-value="{{url}}" aria-role="button" aria-label="url, {{url}}">
      <text aria-hidden="true">url</text>
      <text class="cyl-row-value" aria-hidden="true">{{url}}</text>
    </view>
    <view class="cyl-row cyl-row-action" bindtap="cyl_copyLink" aria-role="button" aria-label="{{texts['Copy link']}}">
      <text aria-hidden="true">{{texts['Copy link']}}</text>
    </view>
  </view>
  <template is="cylFeed" data="{{rows: feedRows, title: texts['Feed']}}" />
</view>
