<!-- [EN] Arabic: the page right to left. [CN] 阿拉伯语：页面从右到左。 -->
<page-meta page-style="{{cylRTL ? 'direction: rtl;' : ''}}"></page-meta>
<view wx:if="{{!cylUnloaded}}" class="cyl-page" bindtouchstart="cylOnSwipeStart" bindtouchend="cylOnSwipeEnd">
  <view class="cyl-header">
    <text class="cyl-header-title" aria-role="heading">{{texts['Post']}}</text>
    <text class="cyl-header-subtitle">{{texts["The plus button's own page (CYLTabBarItemPageIdentifier: publish)."]}}</text>
  </view>
</view>
