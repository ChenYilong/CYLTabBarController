<view class="cyl-page">
  <view class="cyl-lottie-stage">
    <cyl-pag
      wx:if="{{isPAG}}"
      id="cyl-playground"
      class="cyl-lottie-view"
      path="{{path}}"
      loop="{{loop}}"
      fit="{{fit}}"
      label="{{texts['Animation']}}, {{file}}"
      bind:ready="cyl_event"
      bind:complete="cyl_event"
      bind:loopcomplete="cyl_event"
      bind:error="cyl_event"
    />
    <!-- [EN] With Rive installed: cyl-rive, its options in the path's fragment (house.riv steps its Rooms number input on each play).
         [CN] 安装 Rive 时：cyl-rive，选项写在路径的 fragment 中（house.riv 每次播放改变其 Rooms 数字输入）。 -->
    <cyl-rive
      wx:elif="{{isRive}}"
      id="cyl-playground"
      class="cyl-lottie-view"
      path="{{path}}"
      loop="{{loop}}"
      speed="{{speed}}"
      fit="{{fit}}"
      label="{{texts['Animation']}}, {{file}}"
      bind:ready="cyl_event"
      bind:complete="cyl_event"
      bind:loopcomplete="cyl_event"
      bind:error="cyl_event"
    />
    <cyl-lottie
      wx:else
      id="cyl-playground"
      class="cyl-lottie-view"
      path="{{path}}"
      loop="{{loop}}"
      speed="{{speed}}"
      fit="{{fit}}"
      colors="{{colors}}"
      label="{{texts['Animation']}}, {{file}}"
      bind:ready="cyl_event"
      bind:complete="cyl_event"
      bind:loopcomplete="cyl_event"
      bind:error="cyl_event"
    />
  </view>

  <text class="cyl-section-title" aria-role="heading">{{texts['Animation']}}</text>
  <view class="cyl-section">
    <view wx:for="{{files}}" wx:key="*this" class="cyl-row {{file === item ? 'cyl-row-selected' : ''}}" bindtap="cyl_file" data-value="{{item}}" aria-role="button" aria-selected="{{file === item}}" aria-label="{{item}}"><text aria-hidden="true">{{item}}</text></view>
  </view>

  <view class="cyl-section cyl-buttons">
    <view class="cyl-row cyl-row-action" bindtap="cylPlay" aria-role="button" aria-label="{{texts['Play']}}"><text aria-hidden="true">{{texts['Play']}}</text></view>
    <view class="cyl-row cyl-row-action" bindtap="cylPause" aria-role="button" aria-label="{{texts['Pause']}}"><text aria-hidden="true">{{texts['Pause']}}</text></view>
    <view class="cyl-row cyl-row-action" bindtap="cylStop" aria-role="button" aria-label="{{texts['Stop']}}"><text aria-hidden="true">{{texts['Stop']}}</text></view>
  </view>

  <text class="cyl-section-title" aria-role="heading">{{texts['Speed']}}</text>
  <view class="cyl-section">
    <view wx:for="{{speeds}}" wx:key="*this" class="cyl-row {{speed === item ? 'cyl-row-selected' : ''}}" bindtap="cyl_speed" data-value="{{item}}" aria-role="button" aria-selected="{{speed === item}}" aria-label="{{texts['Speed']}} {{item}}"><text aria-hidden="true">{{item}}×</text></view>
  </view>

  <text class="cyl-section-title" aria-role="heading">{{texts['Fit']}}</text>
  <view class="cyl-section">
    <view wx:for="{{fits}}" wx:key="*this" class="cyl-row {{fit === item ? 'cyl-row-selected' : ''}}" bindtap="cyl_fit" data-value="{{item}}" aria-role="button" aria-selected="{{fit === item}}" aria-label="{{item}}"><text aria-hidden="true">{{item}}</text></view>
  </view>

  <view class="cyl-section cyl-buttons">
    <view class="cyl-row">
      <text aria-hidden="true">{{texts['Loop']}}</text>
      <switch checked="{{loop}}" bindchange="cyl_loop" aria-label="{{texts['Loop']}}" />
    </view>
    <view class="cyl-row">
      <text aria-hidden="true">{{texts['Recolor']}}</text>
      <switch checked="{{colors !== null}}" bindchange="cyl_recolor" aria-label="{{texts['Recolor']}}" />
    </view>
  </view>

  <!-- [EN] showsImageWhenAnimationEnds (docs/Animated-Item.md): a play-once Lottie item ends on its still image; Play shows the
       animation again, the switch keeps the last frame instead, and the row counts animationcomplete.
       [CN] showsImageWhenAnimationEnds（docs/Animated-Item.md）：只播放一次的 Lottie 条目结束后显示静态图片；播放重新显示动画，开关关闭时保留最后一帧，
       该行统计 animationcomplete。 -->
  <block wx:if="{{!isPAG && !isRive}}">
    <text class="cyl-section-title" aria-role="heading">showsImageWhenAnimationEnds</text>
    <view class="cyl-lottie-stage">
      <cyl-animated-item
        id="cyl-end-item"
        generic:cyl-lottie-view="cyl-lottie"
        class="cyl-end-item"
        bare="{{true}}"
        icon-size="{{72}}"
        image="/shared/objc/home_highlight.png"
        animation-url="/shared/lottie/green_lottie_tab_home.json"
        selected="{{true}}"
        shows-image-when-animation-ends="{{endImage}}"
        bind:animationcomplete="cyl_endItemComplete"
      />
    </view>
    <view class="cyl-section">
      <view id="cyl-end-play" class="cyl-row cyl-row-action" bindtap="cyl_endItemPlay" aria-role="button" aria-label="{{texts['Play']}}, showsImageWhenAnimationEnds"><text aria-hidden="true">{{texts['Play']}}</text></view>
      <view class="cyl-row">
        <text aria-hidden="true">showsImageWhenAnimationEnds</text>
        <switch checked="{{endImage}}" bindchange="cyl_endImage" aria-label="showsImageWhenAnimationEnds" />
      </view>
      <view class="cyl-row" aria-label="animationcomplete × {{endCount}}"><text class="cyl-row-value" aria-hidden="true">animationcomplete × {{endCount}}</text></view>
    </view>
  </block>

  <text class="cyl-section-title" aria-role="heading">{{texts['Events']}}</text>
  <view class="cyl-section">
    <view wx:for="{{events}}" wx:key="index" class="cyl-row" hover-class="cyl-row-pressed" bindtap="cyl_copyEvent" data-value="{{item}}" aria-role="button" aria-label="{{item}}"><text class="cyl-row-value" aria-hidden="true">{{item}}</text></view>
  </view>
</view>
