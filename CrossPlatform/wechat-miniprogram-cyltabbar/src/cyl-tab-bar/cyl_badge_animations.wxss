/*
 * [EN] Badge animations, as CYLBadgeAnimationType of the iOS library (CYLBadgeAnimationTypeBreathe, Scale, Shake, Bounce,
 *      ScaleOnce): a badge with the class cyl-badge-<type> plays it. The repeating ones run until the badge is removed.
 * [CN] 角标动画，对应 iOS 库的 CYLBadgeAnimationType（Breathe、Scale、Shake、Bounce、ScaleOnce）：带 cyl-badge-<类型>
 *      类的角标播放该动画。重复的动画一直播放到角标被移除。
 */
.cyl-badge-breathe {
  animation: cyl-badge-breathe 1.2s ease-in-out infinite alternate;
}

.cyl-badge-scale {
  animation: cyl-badge-scale 0.8s ease-in-out infinite alternate;
}

.cyl-badge-shake {
  animation: cyl-badge-shake 1s ease-in-out infinite;
}

.cyl-badge-bounce {
  animation: cyl-badge-bounce 1s ease-in-out infinite;
}

.cyl-badge-scaleOnce {
  animation: cyl-badge-scale-once 0.4s ease-in-out 1;
}

/* [EN] Opacity 1 to 0.1 and back, as -cyl_opacityForever_Animation:. [CN] 透明度 1 到 0.1 往复。 */
@keyframes cyl-badge-breathe {
  from { opacity: 1; }
  to { opacity: 0.1; }
}

/* [EN] 1.4x and back, as -cyl_scaleFrom:toScale:. [CN] 放大到 1.4 倍再恢复。 */
@keyframes cyl-badge-scale {
  from { transform: scale(1); }
  to { transform: scale(1.4); }
}

/* [EN] Left and right by 3 px, as -cyl_shakeAnimation:. [CN] 左右各 3 px 抖动。 */
@keyframes cyl-badge-shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-3px); }
  40%, 80% { transform: translateX(3px); }
}

/* [EN] Up by 4 px and back, as -cyl_bounceAnimation:. [CN] 向上 4 px 再落下。 */
@keyframes cyl-badge-bounce {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-4px); }
}

@keyframes cyl-badge-scale-once {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.4); }
}
