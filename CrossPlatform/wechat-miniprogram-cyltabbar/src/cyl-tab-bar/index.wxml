<!-- [EN] The tab bar: a tab list with one tab per item and the raised plus button. [CN] TabBar：每项一个 Tab 的列表，以及凸起的 PlusButton。 -->
<view class="cyl-tab-bar cyl-style-{{cylStyleType}} {{cylIsDark ? 'cyl-dark' : ''}} {{tabBarHidden ? 'cyl-tab-bar-hidden' : ''}}" style="{{cylBarStyle}}" aria-role="tablist" aria-hidden="{{tabBarHidden}}">
  <view
    wx:for="{{cylSlots}}"
    wx:key="key"
    class="cyl-tab {{item.selected ? 'cyl-selected' : ''}} {{item.isPlusButton ? 'cyl-plus-slot' : ''}}"
    style="{{item.itemStyle}}"
    data-key="{{item.key}}"
    id="{{item.accessibilityIdentifier}}"
    bindtap="cyl_onTap"
    bindtouchstart="cyl_onTouchStart"
    bindtouchend="cyl_onTouchEnd"
    bindtouchcancel="cyl_onTouchEnd"
    bindtouchmove="cyl_onTouchEnd"
    aria-role="{{item.isPlusButton ? 'button' : 'tab'}}"
    aria-label="{{item.accessibilityLabel}}"
    aria-selected="{{item.selected}}"
  >
    <block wx:if="{{item.isPlusButton}}">
      <!-- [EN] As iOS (CYLPlusButtonShowsSelection): the selection under the plus button exists on Liquid Glass only; it is the same cyl-glass-lens as a selected tab's. [CN] 与 iOS 一致（CYLPlusButtonShowsSelection）：PlusButton 下方的选中效果只在液态玻璃下出现。 -->
      <cyl-glass-lens wx:if="{{item.showsSelection && cylStyleType === 'liquidGlass'}}" class="cyl-plus-selection" is-dark="{{cylIsDark}}" lens-style="{{cylGlassLensStyle}}" aria-hidden="true" />
      <view class="cyl-plus-button {{cylAnimatingIdentifier === item.key ? 'cyl-animate-' + cylAnimatingName + ' cyl-flip-' + cylFlipDirection : ''}}" style="{{item.buttonStyle}} {{cylAnimationStyle}}">
        <view wx:if="{{item.hitStyle}}" class="cyl-plus-hit" style="{{item.hitStyle}}" aria-hidden="true"></view>
        <image wx:if="{{item.backgroundImage}}" class="cyl-plus-background" src="{{item.backgroundImage}}" mode="aspectFit" aria-hidden="true" />
        <view class="cyl-plus-image-box">
          <image wx:if="{{item.image}}" class="cyl-plus-image" src="{{item.image}}" style="{{item.imageStyle}}" mode="aspectFit" aria-hidden="true" />
          <text wx:if="{{item.badge && !item.badge.isDot}}" class="cyl-plus-badge {{item.badge.className}}" style="{{item.badge.style}}" aria-hidden="true">{{item.badge.text}}</text>
          <view wx:if="{{item.badge && item.badge.isDot}}" class="cyl-plus-badge-dot {{item.badge.className}}" style="{{item.badge.style}}" aria-hidden="true"></view>
        </view>
        <text wx:if="{{item.title}}" class="cyl-title" style="{{item.titleStyle}}" aria-hidden="true">{{item.title}}</text>
      </view>
    </block>
    <block wx:else>
      <cyl-tab-bar-item
        id="cyl-item-{{item.key}}"
        generic:cyl-lottie-view="cyl-lottie-view"
        generic:cyl-pag-view="cyl-pag-view"
        generic:cyl-rive-view="cyl-rive-view"
        generic:cyl-svga-view="cyl-svga-view"
        class="cyl-tab-item {{item.cover ? 'cyl-tab-covered' : ''}}"
        index="{{item.item.index}}"
        title="{{item.item.title}}"
        image="{{item.item.image}}"
        selected-image="{{item.item.selectedImage}}"
        selected="{{item.item.selected}}"
        animation-path="{{item.item.animationPath}}"
        animation-size="{{item.item.animationSize}}"
        animation-colors="{{item.item.animationColors}}"
        loops-when-unselected="{{item.item.loopsWhenUnselected}}"
        image-size="{{item.item.imageSize}}"
        image-insets="{{item.item.imageInsets}}"
        title-position-adjustment="{{item.item.titlePositionAdjustment}}"
        icon-tint="{{item.item.iconTint}}"
        selected-icon-tint="{{item.item.selectedIconTint}}"
        background-color="{{item.item.backgroundColor}}"
        selected-background-color="{{item.item.selectedBackgroundColor}}"
        title-text-attributes="{{item.item.titleTextAttributes}}"
        badge-value="{{item.showsDot ? '•' : item.badge}}"
        badge-color="{{item.badgeItem.color}}"
        badge-size="{{item.badgeItem.size}}"
        badge-position-adjustment="{{item.badgeItem.positionAdjustment}}"
        badge-animation="{{item.badgeItem.animation}}"
        animation-class="{{cylAnimatingIdentifier === item.key ? 'cyl-animate-' + cylAnimatingName + ' cyl-flip-' + cylFlipDirection : ''}}"
        animation-duration="{{cylAnimationDuration}}"
        item-style="{{cylItemStyle}}"
        glass-lens-style="{{cylGlassLensStyle}}"
        animation-speed="{{animationSpeed}}"
        animation-loop="{{animationLoop}}"
        is-dark="{{cylIsDark}}"
      />
      <!-- [EN] The frames animation (CYLTabButtonFrameAnimation) and the fireworks over the icon (decoration). [CN] 逐帧动画与图标上的烟花（装饰）。 -->
      <view wx:if="{{cylAnimatingIdentifier === item.key && cylAnimatingName === 'frames'}}" class="cyl-frames" style="{{cylAnimationStyle}}" aria-hidden="true"></view>
      <view wx:if="{{cylFireworks && cylFireworks.key === item.key}}" class="cyl-fireworks" aria-hidden="true">
        <block wx:for="{{cylFireworks.particles}}" wx:for-item="particle" wx:key="index">
          <image wx:if="{{cylFireworks.image}}" class="cyl-firework cyl-firework-image" src="{{cylFireworks.image}}" style="{{particle.style}}" mode="aspectFit" />
          <view wx:else class="cyl-firework" style="{{particle.style}}"></view>
        </block>
      </view>
      <!-- [EN] cyl_setCoverImage: a decoration over the tab; VoiceOver / TalkBack read the tab, not the cover. [CN] 覆盖在 Tab 上的装饰；读屏朗读 Tab 本身，而不是封面。 -->
      <image wx:if="{{item.cover}}" class="cyl-tab-cover" src="{{item.cover.image}}" style="{{item.cover.style}}" mode="aspectFit" aria-hidden="true" />
    </block>
  </view>
</view>
