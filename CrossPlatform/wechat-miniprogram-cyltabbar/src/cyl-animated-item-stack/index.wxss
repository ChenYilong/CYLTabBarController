/* [EN] Fills its parent and centers the column. [CN] 填满父视图并让条目列居中。 */
.cyl-stack {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* [EN] Sized by its items, never wider than the stack: titles wrap. [CN] 大小由条目决定，不超过堆叠宽度：标题换行。 */
.cyl-stack-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 100%;
}
.cyl-stack-item {
  max-width: 100%;
  display: flex;
  justify-content: center;
}
/* [EN] axis 'horizontal': one row, the spacing on the left of each item. [CN] axis 为 'horizontal'：一行，间距位于每个条目左侧。 */
.cyl-stack-row {
  flex-direction: row;
}
/* [EN] hugsContent: sized by the items, not by the parent. [CN] hugsContent：大小由条目决定，而不是父视图。 */
.cyl-stack-hug {
  display: inline-flex;
  width: auto;
  height: auto;
}
/* [EN] The built-in divider keeps its fixed size, centered on the cross axis. [CN] 内置分割线保持固定大小，在交叉轴上居中。 */
.cyl-stack-divider {
  flex: none;
  align-self: center;
}
