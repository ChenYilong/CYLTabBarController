@import './cyl_badge_animations.wxss';

/* [EN] Defaults of the iOS appearance: red, white text, a 8 px dot. [CN] iOS 外观的默认值：红色、白字、8 px 红点。 */
.cyl-badge-text {
  display: inline-block;
  box-sizing: border-box;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  border-radius: 8px;
  background-color: #ff3b30;
  color: #ffffff;
  font-size: 11px;
  line-height: 16px;
  text-align: center;
  white-space: nowrap;
}
.cyl-badge-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #ff3b30;
}
