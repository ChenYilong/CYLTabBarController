<!-- [EN] The mini program's custom tab bar: the cyl-tab-bar component with the example's configuration. [CN] 小程序的自定义 TabBar：带有示例配置的 cyl-tab-bar 组件。 -->
<cyl-tab-bar
  id="cyl-tab-bar"
  configuration="{{configuration}}"
  strings="{{strings}}"
  symbols-by-theme="{{symbolsByTheme}}"
  selected-identifier="{{selectedIdentifier}}"
  logged-in="{{loggedIn}}"
  bind:select="cyl_onSelect"
  bind:reselect="cyl_onReselect"
  bind:plustap="cyl_onPlusTap"
  bind:loginrequired="cyl_onLoginRequired"
/>
