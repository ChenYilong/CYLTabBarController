<!-- [EN] The tab bar: a tab list with one tab per item and the raised plus button. [CN] TabBar：每项一个 Tab 的列表，以及凸起的 PlusButton。 -->
<view class="cyl-tab-bar cyl-style-{{cylStyleType}} {{cylIsDark ? 'cyl-dark' : ''}}" style="{{cylBarStyle}}" aria-role="tablist">
  <view
    wx:for="{{cylSlots}}"
    wx:key="key"
    class="cyl-tab {{item.selected ? 'cyl-selected' : ''}} {{item.isPlusButton ? 'cyl-plus-slot' : ''}}"
    style="{{item.itemStyle}}"
    data-key="{{item.key}}"
    id="{{item.accessibilityIdentifier}}"
    bindtap="cyl_onTap"
    aria-role="{{item.isPlusButton ? 'button' : 'tab'}}"
    aria-label="{{item.accessibilityLabel}}"
    aria-selected="{{item.selected}}"
  >
    <block wx:if="{{item.isPlusButton}}">
      <view class="cyl-plus-button {{cylAnimatingIdentifier === item.key ? 'cyl-animate-' + cylTapAnimation : ''}}" style="{{item.buttonStyle}} {{cylAnimationStyle}}">
        <image wx:if="{{item.backgroundImage}}" class="cyl-plus-background" src="{{item.backgroundImage}}" mode="aspectFit" aria-hidden="true" />
        <image wx:if="{{item.image}}" class="cyl-plus-image" src="{{item.image}}" style="{{item.imageStyle}}" mode="aspectFit" aria-hidden="true" />
        <text wx:if="{{item.title}}" class="cyl-title" style="{{item.titleStyle}}" aria-hidden="true">{{item.title}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="cyl-tab-content {{cylAnimatingIdentifier === item.key ? 'cyl-animate-' + cylTapAnimation : ''}}" style="{{cylAnimationStyle}}">
        <view class="cyl-icon-box">
          <image wx:if="{{item.image}}" class="cyl-icon" src="{{item.image}}" style="{{item.imageStyle}}" mode="aspectFit" aria-hidden="true" />
          <text wx:if="{{item.badge}}" class="cyl-badge" aria-hidden="true">{{item.badge}}</text>
          <view wx:if="{{item.showsDot}}" class="cyl-badge-dot" aria-hidden="true"></view>
        </view>
        <text wx:if="{{item.title}}" class="cyl-title" style="{{item.titleStyle}}" aria-hidden="true">{{item.title}}</text>
      </view>
    </block>
  </view>
</view>
