platform :ios, '15.0'

ENV['SWIFT_VERSION'] = '5'

project 'AnimatedApp.xcodeproj'

target 'AnimatedApp' do
  use_frameworks!

  # Rive tab icons, the same way as `CYLTabBarController/LottieSwift` and `CYLTabBarController/PAG`; it also brings the
  # RiveRuntime pod, so the app needs no Swift package. Rive Tab 图标，用法与 LottieSwift、PAG 相同；同时引入 RiveRuntime pod，
  # 因此 App 不再需要 Swift Package。
  pod 'CYLTabBarController/Rive', :path => '../'
  pod 'CYLDeallocBlockExecutor', :git => 'https://github.com/ChenYilong/CYLDeallocBlockExecutor.git', :commit => '38d67f5a714c1f1407aee14e12e974af66bd2787' # TODO: remove after CYLDeallocBlockExecutor 1.4.0 is published (docs/Lifecycle-Library.md)
  # [EN] The animated item component's own pod (CYLAnimatedItem.podspec), by the same path until it is on the trunk.
  # [CN] 动效组件独立的 pod（CYLAnimatedItem.podspec），发布到 trunk 之前按相同路径引入。
  pod 'CYLAnimatedItem', :path => '../'
  # FIX: issue #415 — SVGA tab icons (SVGAPlayer), one for one with the Rive ones, chosen on the Bell page.
  # SVGA Tab 图标（SVGAPlayer），与 Rive 图标一一对应，在 Bell 页面选择。
  pod 'CYLTabBarController/SVGA', :path => '../'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
