# Uncomment the next line to define a global platform for your project
platform :ios, '15.0'

ENV['SWIFT_VERSION'] = '5'

project 'CYLTabBarController-Swift.xcodeproj'

target 'CYLTabBarController-Swift' do
  # Comment the next line if you're not using Swift and don't want to use dynamic frameworks
  use_frameworks!
  
#  pod 'CYLTabBarController', '1.99.4'
  pod 'CYLTabBarController', :path => '../'
  pod 'CYLDeallocBlockExecutor', :git => 'https://github.com/ChenYilong/CYLDeallocBlockExecutor.git', :commit => '4276a6dab5a428ccc3a5f3f347eab991881fb97c' # TODO: remove after CYLDeallocBlockExecutor 1.4.0 is published (docs/Lifecycle-Library.md)
  # [EN] The animated item component's own pod (CYLAnimatedItem.podspec), by the same path until it is on the trunk.
  # [CN] 动效组件独立的 pod（CYLAnimatedItem.podspec），发布到 trunk 之前按相同路径引入。
  pod 'CYLUtils', :path => '../'
  pod 'CYLBadge', :path => '../'
  pod 'CYLAnimatedItem', :path => '../'
  # [EN] The Badge page is a ClassifyMenu tag list (docs/instructions/examples.md, "Demo lists that need sections use a ClassifyMenu tag list"). Pinned by commit,
  #      the same pin as the root Podfile (Example/); no copy of its sources.
  # [CN] Badge 页面使用 ClassifyMenu 的 TagList（docs/instructions/examples.md）。按 commit 固定，与根目录 Podfile（Example/）的 pin 相同；不复制其源码。
  pod 'CollectionViewClassifyMenu', :git => 'https://github.com/ChenYilong/CollectionViewClassifyMenu.git', :commit => 'e4d883a209878d4bf03b7d7db2cb9c1fa5293157'

  # Pods for CYLTabBarController-Swift

end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
